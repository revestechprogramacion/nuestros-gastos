# Copia este archivo como ".env" y rellena los dos valores.
# Los encuentras en Supabase → tu proyecto → Settings → API.
#
# Mientras estas dos líneas estén vacías, la app funciona en MODO LOCAL:
# los datos se guardan solo en el navegador y no se comparten.

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
